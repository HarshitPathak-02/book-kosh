<%- layout('/layouts/boilerplate') %>
<body>
    <div class="main_upsc">
        <div class="heading_upsc">
            <h1>UPSC Books</h1>
            <!-- <p>The Best Platform for Second Hand Books!!</p> -->
        </div>
        <div class="list_of_books">
           <% for (let b of upscBooks) { %>
            <% if (b.category == "UPSC") { %>
                <div class="card crdcustom">
                    <img src="<%= b.coverimage.url %>" class="card-img-top" style="height: 15rem; width: 20rem;" alt="...">
                    <div class="card-body">
                      <h5 class="card-title"><%= b.title %></h5>
                      <p class="card-text"><%= b.author %></p>
                      <p class="card-text"><%= b.price %></p>
                      <p class="card-text"><%= b.description %></p>
                    </div>
                    <div class="btns">
                        <a href="/payment" class="btn btncustom btn-primary" style="height: 5rem;">Buy Book</a>
                    </div>
                </div>
            <% } %>
          <%  } %>
        </div>

    </div>
</body>